APP_NAME="Ky Servicer Center"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ── Database ─────────────────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# ── Session / Cache / Queue ───────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=pusher
QUEUE_CONNECTION=database
CACHE_STORE=database

# ── Pusher ────────────────────────────────────────────────────────────────────
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=ap1
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_VERIFY=true
PUSHER_CA_BUNDLE=

# ── Filesystem (Cloudflare R2 / S3) ──────────────────────────────────────────
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_SSL_VERIFY=false

# ── Firebase (mounted via docker-compose volume) ──────────────────────────────
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS=/var/www/html/storage/app/firebase-credentials.json

# ── Mail ──────────────────────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="KneaYerng App"

SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=
SENDGRID_VERIFY=false
SENDGRID_CA_BUNDLE=

# ── OTP ───────────────────────────────────────────────────────────────────────
OTP_DEFAULT_PHONE_COUNTRY_CODE=+855
OTP_CODE_LENGTH=6
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_LOCK_SECONDS=600
OTP_DEST_RATE_PER_HOUR=5
OTP_IP_RATE_PER_10M=10
OTP_EMAIL_SUBJECT="Your OTP Code"
OTP_SMS_PROVIDER=unimatrix
OTP_LOCAL_FALLBACK=false

# ── SMS / Unimatrix ───────────────────────────────────────────────────────────
UNIMATRIX_BASE_URL=https://api.unimtx.com
UNIMATRIX_ACCESS_KEY_ID=
UNIMATRIX_ACCESS_KEY_SECRET=
UNIMATRIX_CHANNEL=sms
UNIMATRIX_TIMEOUT=15
UNIMATRIX_VERIFY=true
UNIMATRIX_CA_BUNDLE=

# ── Twilio ────────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ── Infobip ───────────────────────────────────────────────────────────────────
INFOBIP_BASE_URL=
INFOBIP_API_KEY=
INFOBIP_SMS_SENDER=OTP
INFOBIP_EMAIL_FROM=
INFOBIP_EMAIL_FROM_NAME=OTP

# ── Bakong payment ────────────────────────────────────────────────────────────
BAKONG_ENV=sandbox
BAKONG_ACCOUNT_ID=
BAKONG_MERCHANT_ID=DEMO_MERCHANT
BAKONG_MERCHANT_NAME="KneaYerng Service Center"
BAKONG_MERCHANT_CITY="Phnom Penh"
BAKONG_MERCHANT_CATEGORY=5999
BAKONG_COUNTRY_CODE=KH
BAKONG_QR_EXPIRES_MINUTES=10
BAKONG_BASE_URL=https://api-bakong.nbc.gov.kh/v1
BAKONG_TOKEN=
BAKONG_OPEN_VERIFY=false

# ── Telegram ──────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_GROUP_CHAT_ID=
TELEGRAM_VERIFY=true

# ── Anthropic (AI product description generation) ────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_TIMEOUT=20

# ── Sanctum ───────────────────────────────────────────────────────────────────
SANCTUM_STATEFUL_DOMAINS=

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_ADMIN_NOTIFICATION_SOUND=/sounds/mixkit-bell-notification-933.wav
